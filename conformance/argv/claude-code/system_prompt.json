{
  "description": "--system-prompt is supported natively by claude.",
  "harness_name": "claude-code",
  "request": {
    "prompt": "hello",
    "system_prompt": "Be terse."
  },
  "expected_argv": [
    "claude",
    "-p",
    "--output-format",
