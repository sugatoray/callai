include README.md
include src/callai/py.typed  # marker file for PEP 561

include CHANGELOG.md
include LICENSE

include MANIFEST.in
include pyproject.toml
include uv.lock
include .python-version

# Not listed on purpose: tests (src/tests), conformance/, docs/, build/, dist/, .github/, .agents/,
# .claude/, Makefile, the agent/scrolls files. Without a VCS plugin (setuptools-scm) setuptools only
# packs the files above plus the packages found in src/ (callai*), so they stay out of the sdist.
# If a plugin is added later, restore `recursive-exclude` lines for them.

# Maintainer tools (banner builder, its template, config and tests) never ship. Failsafe, kept on purpose:
# setuptools doesn't pack src/tools today, so `uv build` warns "no previously-included ... matching";
# these lines keep it out if a VCS plugin (setuptools-scm) or a package-find change ever pulls it in.
prune src/tools
recursive-exclude src/tools *
